@namespace SchoolManagement.Api.EmailTemplates
@* Invoice/Payment Email Template *@
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Invoice</title>
    <style>
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
            line-height: 1.6;
            color: #333;
            margin: 0;
            padding: 0;
            background-color: #f4f4f4;
        }
        .email-container {
            max-width: 600px;
            margin: 40px auto;
            background-color: #ffffff;
            border-radius: 8px;
            overflow: hidden;
            box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        }
        .header {
            background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
            padding: 40px 30px;
            text-align: center;
            color: white;
        }
        .header h1 {
            margin: 0;
            font-size: 28px;
            font-weight: 600;
        }
        .content {
            padding: 40px 30px;
        }
        .invoice-details {
            background-color: #f8f9fa;
            border-radius: 6px;
            padding: 20px;
            margin: 20px 0;
        }
        .invoice-row {
            display: flex;
            justify-content: space-between;
            padding: 10px 0;
            border-bottom: 1px solid #dee2e6;
        }
        .invoice-row:last-child {
            border-bottom: none;
        }
        .invoice-total {
            font-size: 20px;
            font-weight: 600;
            color: #4facfe;
            margin-top: 10px;
        }
        .pay-button {
            display: inline-block;
            padding: 14px 36px;
            background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
            color: white !important;
            text-decoration: none;
            border-radius: 6px;
            font-weight: 600;
            font-size: 16px;
            text-align: center;
            margin: 20px 0;
        }
        .footer {
            background-color: #f8f9fa;
            padding: 30px;
            text-align: center;
            color: #6c757d;
            font-size: 14px;
        }
    </style>
</head>
<body>
    <div class="email-container">
        <div class="header">
            <h1>💳 Invoice #@InvoiceNumber</h1>
        </div>
        <div class="content">
            <h2>Hello @StudentName,</h2>
            <p>Your invoice for <strong>@Description</strong> is ready.</p>

            <div class="invoice-details">
                <div class="invoice-row">
                    <span><strong>Invoice Number:</strong></span>
                    <span>@InvoiceNumber</span>
                </div>
                <div class="invoice-row">
                    <span><strong>Date:</strong></span>
                    <span>@InvoiceDate</span>
                </div>
                <div class="invoice-row">
                    <span><strong>Due Date:</strong></span>
                    <span>@DueDate</span>
                </div>
                <div class="invoice-row">
                    <span><strong>Amount:</strong></span>
                    <span class="invoice-total">@Amount @Currency</span>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(PaymentUrl))
            {
                <div style="text-align: center;">
                    <a href="@PaymentUrl" class="pay-button">
                        Pay Now
                    </a>
                </div>
            }

            <p style="font-size: 14px; color: #6c757d;">
                If you have any questions about this invoice, please contact our billing department.
            </p>
        </div>
        <div class="footer">
            <p><strong>School Management System</strong></p>
            <p>© @DateTime.UtcNow.Year All rights reserved.</p>
        </div>
    </div>
</body>
</html>

@code {
    [Parameter] public string StudentName { get; set; } = "Student";
    [Parameter] public string InvoiceNumber { get; set; } = "INV-0000";
    [Parameter] public string Description { get; set; } = "Tuition Fees";
    [Parameter] public string InvoiceDate { get; set; } = DateTime.UtcNow.ToString("yyyy-MM-dd");
    [Parameter] public string DueDate { get; set; } = DateTime.UtcNow.AddDays(30).ToString("yyyy-MM-dd");
    [Parameter] public string Amount { get; set; } = "0.00";
    [Parameter] public string Currency { get; set; } = "MAD";
    [Parameter] public string? PaymentUrl { get; set; }
}
