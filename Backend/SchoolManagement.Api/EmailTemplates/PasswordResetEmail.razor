@namespace SchoolManagement.Api.EmailTemplates
@* Password Reset Email Template *@
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Password Reset</title>
    <style>
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
            line-height: 1.6;
            color: #333;
            margin: 0;
            padding: 0;
            background-color: #f4f4f4;
        }
        .email-container {
            max-width: 600px;
            margin: 40px auto;
            background-color: #ffffff;
            border-radius: 8px;
            overflow: hidden;
            box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        }
        .header {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            padding: 40px 30px;
            text-align: center;
            color: white;
        }
        .header h1 {
            margin: 0;
            font-size: 28px;
            font-weight: 600;
        }
        .content {
            padding: 40px 30px;
        }
        .content h2 {
            color: #333;
            font-size: 24px;
            margin-bottom: 20px;
        }
        .content p {
            color: #666;
            margin-bottom: 20px;
            font-size: 16px;
        }
        .reset-button {
            display: inline-block;
            padding: 14px 36px;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white !important;
            text-decoration: none;
            border-radius: 6px;
            font-weight: 600;
            font-size: 16px;
            text-align: center;
            margin: 20px 0;
            transition: transform 0.2s;
        }
        .reset-button:hover {
            transform: translateY(-2px);
        }
        .token-box {
            background-color: #f8f9fa;
            border: 1px dashed #dee2e6;
            border-radius: 6px;
            padding: 16px;
            margin: 20px 0;
            text-align: center;
            font-family: 'Courier New', monospace;
            font-size: 18px;
            color: #495057;
            word-break: break-all;
        }
        .warning {
            background-color: #fff3cd;
            border-left: 4px solid #ffc107;
            padding: 16px;
            margin: 20px 0;
            border-radius: 4px;
        }
        .warning p {
            margin: 0;
            color: #856404;
            font-size: 14px;
        }
        .footer {
            background-color: #f8f9fa;
            padding: 30px;
            text-align: center;
            color: #6c757d;
            font-size: 14px;
        }
        .footer p {
            margin: 5px 0;
            color: #6c757d;
        }
        .divider {
            height: 1px;
            background-color: #e9ecef;
            margin: 30px 0;
        }
        .security-info {
            background-color: #e7f3ff;
            border-left: 4px solid #2196F3;
            padding: 16px;
            margin: 20px 0;
            border-radius: 4px;
        }
        .security-info p {
            margin: 5px 0;
            color: #004085;
            font-size: 14px;
        }
    </style>
</head>
<body>
    <div class="email-container">
        <!-- Header -->
        <div class="header">
            <h1>🔐 Password Reset Request</h1>
        </div>

        <!-- Content -->
        <div class="content">
            <h2>Hello @UserName,</h2>
            
            <p>We received a request to reset your password for your School Management account.</p>

            <p>Click the button below to reset your password:</p>

            <!-- Reset Button -->
            <div style="text-align: center;">
                <a href="@ResetUrl" class="reset-button">
                    Reset My Password
                </a>
            </div>

            <!-- Alternative: Token Display -->
            @if (!string.IsNullOrEmpty(Token))
            {
                <div class="divider"></div>
                <p style="color: #666; font-size: 14px;">Or copy and paste this code:</p>
                <div class="token-box">
                    @Token
                </div>
            }

            <!-- Security Warning -->
            <div class="warning">
                <p><strong>⚠️ Security Notice:</strong></p>
                <p>This link will expire in <strong>@ExpirationMinutes minutes</strong>. If you didn't request this reset, please ignore this email or contact support immediately.</p>
            </div>

            <!-- Additional Security Info -->
            <div class="security-info">
                <p><strong>🛡️ Request Details:</strong></p>
                <p><strong>Time:</strong> @RequestTime</p>
                <p><strong>IP Address:</strong> @IpAddress</p>
                <p><strong>Browser:</strong> @UserAgent</p>
            </div>

            <div class="divider"></div>

            <p style="font-size: 14px; color: #6c757d;">
                If you didn't request a password reset, you can safely ignore this email. Your password will remain unchanged.
            </p>
        </div>

        <!-- Footer -->
        <div class="footer">
            <p><strong>School Management System</strong></p>
            <p>This is an automated message, please do not reply.</p>
            <p>© @DateTime.UtcNow.Year All rights reserved.</p>
            <p style="margin-top: 15px;">
                <a href="@SupportUrl" style="color: #667eea; text-decoration: none;">Contact Support</a> | 
                <a href="@PrivacyUrl" style="color: #667eea; text-decoration: none;">Privacy Policy</a>
            </p>
        </div>
    </div>
</body>
</html>

@code {
    [Parameter] public string UserName { get; set; } = "User";
    [Parameter] public string Token { get; set; } = string.Empty;
    [Parameter] public string ResetUrl { get; set; } = string.Empty;
    [Parameter] public int ExpirationMinutes { get; set; } = 60;
    [Parameter] public string RequestTime { get; set; } = DateTime.UtcNow.ToString("yyyy-MM-dd HH:mm:ss UTC");
    [Parameter] public string IpAddress { get; set; } = "Unknown";
    [Parameter] public string UserAgent { get; set; } = "Unknown";
    [Parameter] public string SupportUrl { get; set; } = "mailto:support@schoolmanagement.com";
    [Parameter] public string PrivacyUrl { get; set; } = "#";
}
