@namespace SchoolManagement.Api.EmailTemplates
@* Account Locked Email Template *@
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Account Locked</title>
    <style>
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
            line-height: 1.6;
            color: #333;
            margin: 0;
            padding: 0;
            background-color: #f4f4f4;
        }
        .email-container {
            max-width: 600px;
            margin: 40px auto;
            background-color: #ffffff;
            border-radius: 8px;
            overflow: hidden;
            box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        }
        .header {
            background: linear-gradient(135deg, #fc4a1a 0%, #f7b733 100%);
            padding: 40px 30px;
            text-align: center;
            color: white;
        }
        .content {
            padding: 40px 30px;
        }
        .alert-box {
            background-color: #fff3cd;
            border-left: 4px solid #ffc107;
            padding: 16px;
            margin: 20px 0;
            border-radius: 4px;
        }
        .footer {
            background-color: #f8f9fa;
            padding: 30px;
            text-align: center;
            color: #6c757d;
            font-size: 14px;
        }
    </style>
</head>
<body>
    <div class="email-container">
        <div class="header">
            <h1>🔒 Account Security Alert</h1>
        </div>
        <div class="content">
            <h2>Hello @UserName,</h2>
            
            <div class="alert-box">
                <p><strong>⚠️ Your account has been temporarily locked</strong></p>
                <p>We detected multiple failed login attempts on your account.</p>
            </div>

            <p><strong>Details:</strong></p>
            <ul>
                <li>Time: @LockoutTime</li>
                <li>IP Address: @IpAddress</li>
                <li>Failed Attempts: @FailedAttempts</li>
            </ul>

            <p>If this was you, you can unlock your account by resetting your password. If you didn't try to log in, please contact support immediately.</p>

            <p>Your account will automatically unlock after @LockoutMinutes minutes.</p>
        </div>
        <div class="footer">
            <p><strong>School Management System</strong></p>
            <p>© @DateTime.UtcNow.Year All rights reserved.</p>
        </div>
    </div>
</body>
</html>

@code {
    [Parameter] public string UserName { get; set; } = "User";
    [Parameter] public string LockoutTime { get; set; } = DateTime.UtcNow.ToString("yyyy-MM-dd HH:mm:ss UTC");
    [Parameter] public string IpAddress { get; set; } = "Unknown";
    [Parameter] public int FailedAttempts { get; set; } = 5;
    [Parameter] public int LockoutMinutes { get; set; } = 15;
}
