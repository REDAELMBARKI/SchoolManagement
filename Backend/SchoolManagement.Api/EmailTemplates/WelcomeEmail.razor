@namespace SchoolManagement.Api.EmailTemplates
@* Welcome Email Template *@
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Welcome</title>
    <style>
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
            line-height: 1.6;
            color: #333;
            margin: 0;
            padding: 0;
            background-color: #f4f4f4;
        }
        .email-container {
            max-width: 600px;
            margin: 40px auto;
            background-color: #ffffff;
            border-radius: 8px;
            overflow: hidden;
            box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        }
        .header {
            background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
            padding: 40px 30px;
            text-align: center;
            color: white;
        }
        .header h1 {
            margin: 0;
            font-size: 28px;
            font-weight: 600;
        }
        .content {
            padding: 40px 30px;
        }
        .footer {
            background-color: #f8f9fa;
            padding: 30px;
            text-align: center;
            color: #6c757d;
            font-size: 14px;
        }
        .feature-box {
            background-color: #f8f9fa;
            border-radius: 6px;
            padding: 20px;
            margin: 15px 0;
        }
    </style>
</head>
<body>
    <div class="email-container">
        <div class="header">
            <h1>🎉 Welcome to School Management!</h1>
        </div>
        <div class="content">
            <h2>Hello @UserName,</h2>
            <p>Your account has been successfully created! We're excited to have you on board.</p>
            
            <div class="feature-box">
                <h3>🚀 Getting Started</h3>
                <ul>
                    <li>Complete your profile</li>
                    <li>Explore the dashboard</li>
                    <li>Connect with your school community</li>
                </ul>
            </div>

            <p>If you have any questions, feel free to reach out to our support team.</p>
        </div>
        <div class="footer">
            <p><strong>School Management System</strong></p>
            <p>© @DateTime.UtcNow.Year All rights reserved.</p>
        </div>
    </div>
</body>
</html>

@code {
    [Parameter] public string UserName { get; set; } = "User";
}
