@namespace SchoolManagement.Api.EmailTemplates
@* Email Confirmation Template *@
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Email Confirmation</title>
    <style>
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
            line-height: 1.6;
            color: #333;
            margin: 0;
            padding: 0;
            background-color: #f4f4f4;
        }
        .email-container {
            max-width: 600px;
            margin: 40px auto;
            background-color: #ffffff;
            border-radius: 8px;
            overflow: hidden;
            box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        }
        .header {
            background: linear-gradient(135deg, #11998e 0%, #38ef7d 100%);
            padding: 40px 30px;
            text-align: center;
            color: white;
        }
        .header h1 {
            margin: 0;
            font-size: 28px;
            font-weight: 600;
        }
        .content {
            padding: 40px 30px;
        }
        .content h2 {
            color: #333;
            font-size: 24px;
            margin-bottom: 20px;
        }
        .content p {
            color: #666;
            margin-bottom: 20px;
            font-size: 16px;
        }
        .confirm-button {
            display: inline-block;
            padding: 14px 36px;
            background: linear-gradient(135deg, #11998e 0%, #38ef7d 100%);
            color: white !important;
            text-decoration: none;
            border-radius: 6px;
            font-weight: 600;
            font-size: 16px;
            text-align: center;
            margin: 20px 0;
        }
        .footer {
            background-color: #f8f9fa;
            padding: 30px;
            text-align: center;
            color: #6c757d;
            font-size: 14px;
        }
    </style>
</head>
<body>
    <div class="email-container">
        <div class="header">
            <h1>✉️ Confirm Your Email</h1>
        </div>
        <div class="content">
            <h2>Welcome, @UserName!</h2>
            <p>Thanks for signing up! Please confirm your email address to activate your account.</p>
            <div style="text-align: center;">
                <a href="@ConfirmUrl" class="confirm-button">
                    Confirm Email Address
                </a>
            </div>
            <p style="font-size: 14px; color: #6c757d; margin-top: 30px;">
                This link will expire in @ExpirationHours hours.
            </p>
        </div>
        <div class="footer">
            <p><strong>School Management System</strong></p>
            <p>© @DateTime.UtcNow.Year All rights reserved.</p>
        </div>
    </div>
</body>
</html>

@code {
    [Parameter] public string UserName { get; set; } = "User";
    [Parameter] public string ConfirmUrl { get; set; } = string.Empty;
    [Parameter] public int ExpirationHours { get; set; } = 24;
}
